<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>LuvLetter.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <NativeProject Include="..\LuvLetter.Core\LuvLetter.Core.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <Target Name="BuildNativeCore" BeforeTargets="Build">
    <MSBuild Projects="@(NativeProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>
</Project>
