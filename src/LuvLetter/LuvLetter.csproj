<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>LuvLetter.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuvLetter.Core\LuvLetter.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SkipNativeBuild)' != 'true' and '$(MSBuildRuntimeType)' == 'Full'">
    <ProjectReference
      Include="..\LuvLetter.Native\LuvLetter.Native.vcxproj"
      ReferenceOutputAssembly="false"
      SkipGetTargetFrameworkProperties="true"
      SetPlatform="Platform=x64" />
  </ItemGroup>

  <PropertyGroup>
    <NativeRendererPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\LuvLetter.Native.dll</NativeRendererPath>
  </PropertyGroup>

  <Target
    Name="RequireVisualStudioMsBuildForNativeRenderer"
    BeforeTargets="PrepareForBuild"
    Condition="'$(SkipNativeBuild)' != 'true' and '$(BuildingSolutionFile)' != 'true' and '$(MSBuildRuntimeType)' != 'Full'">
    <Error Text="LuvLetter.Native requires the full Visual Studio MSBuild. Build LuvLetter.slnx with MSBuild.exe, or set SkipNativeBuild=true only when a current native DLL already exists." />
  </Target>

  <Target Name="IncludeNativeRendererInPublish" AfterTargets="ComputeFilesToPublish">
    <Error
      Condition="!Exists('$(NativeRendererPath)')"
      Text="Native renderer not found at $(NativeRendererPath). Build the solution with Visual Studio MSBuild before publishing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(NativeRendererPath)">
        <RelativePath>LuvLetter.Native.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
